# --- LLM ---
OPENAI_API_KEY=sk-proj-...
# Planner model (native OpenAI id). Luna = OpenAI's small GPT-5.6, fast + cheap.
PLANNER_MODEL=gpt-5.6-luna
# none | low | medium. "none" is the lowest latency; chat/completions requires "none" when tools are attached.
PLANNER_REASONING_EFFORT=none

# --- Server ---
PORT=3000
# Shared secret the app sends as `x-app-key`. Leave empty to disable (local dev only).
APP_API_KEY=
# Public base URL of this server (used to build OAuth redirect URIs)
PUBLIC_BASE_URL=http://localhost:3000
# Custom URL scheme the app registers; OAuth flows bounce back to it.
APP_URL_SCHEME=drivingassistant

# --- Slack (https://api.slack.com/apps -> OAuth & Permissions) ---
# Redirect URL to register: ${PUBLIC_BASE_URL}/oauth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# user token scopes requested
SLACK_USER_SCOPES=chat:write,channels:read,groups:read,im:read,im:write,mpim:read,users:read,channels:history,groups:history,im:history,mpim:history,users.profile:write,search:read

# --- Discord (https://discord.com/developers/applications) ---
# Redirect URL to register: ${PUBLIC_BASE_URL}/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token from the same application; the bot must be invited to the servers the user wants to post in.
DISCORD_BOT_TOKEN=
