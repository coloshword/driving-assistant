# Base URL of the planning server (server/). Use your Mac's LAN IP when testing on a phone.
API_BASE_URL=http://localhost:3000
# Optional shared secret; must match server APP_API_KEY
APP_API_KEY=
# Spotify Developer app (https://developer.spotify.com/dashboard). Redirect URI must be
# exactly: drivingassistant://oauth/spotify
SPOTIFY_CLIENT_ID=
